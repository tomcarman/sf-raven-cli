{
  "name": "sf-raven-cli",
  "description": "A custom sf plugin built by @tomcarman",
  "version": "1.8.1",
  "dependencies": {
    "@inquirer/select": "2.5.0",
    "@oclif/core": "^4.11.4",
    "@salesforce/apex-node": "^8.4.39",
    "@salesforce/core": "^8.2.3",
    "@salesforce/kit": "^3.1.6",
    "@salesforce/sf-plugins-core": "^11.3.12",
    "@salesforce/source-deploy-retrieve": "^12.36.1",
    "@salesforce/ts-types": "^2.0.10",
    "@toon-format/toon": "^4.0.0",
    "chalk": "^4.1.2",
    "cronstrue": "^3.24.0",
    "dayjs": "^1.11.20",
    "fast-xml-parser": "^5.7.3",
    "jsforce": "^3.3.1",
    "node-emoji": "^2.2.0"
  },
  "private": false,
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.3.21",
    "@salesforce/cli-plugins-testkit": "^5.3.58",
    "@salesforce/dev-scripts": "^10.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.42",
    "eslint-plugin-sf-plugin": "^1.20.33",
    "husky": "^9.1.1",
    "oclif": "^4.23.10",
    "pinst": "^3.0.0",
    "shx": "0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wireit": "^0.14.13"
  },
  "overrides": {
    "linkinator": {
      "glob": "12.0.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "mocha": {
      "serialize-javascript": "^7.0.5"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    }
  },
  "resolutions": {
    "linkinator/glob": "12.0.0",
    "**/@typescript-eslint/typescript-estree/minimatch": "^9.0.7",
    "**/mocha/serialize-javascript": "^7.0.5",
    "**/gaxios/uuid": "^11.1.1",
    "**/istanbul-lib-processinfo/uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/oclif.manifest.json",
    "/oclif.lock"
  ],
  "homepage": "https://github.com/tomcarman/sf-raven-cli",
  "bugs": {
    "url": "https://github.com/tomcarman/sf-raven-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomcarman/sf-raven-cli.git"
  },
  "keywords": [
    "force",
    "salesforce",
    "sfdx",
    "salesforcedx",
    "sfdx-plugin",
    "sf-plugin",
    "sf"
  ],
  "license": "BSD-3-Clause",
  "exports": "./lib/index.js",
  "type": "module",
  "main": "index.js",
  "bin": {
    "sf-raven": "bin/dev.js"
  },
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "raven": {
        "description": "Various useful commands.",
        "subtopics": {
          "audit": {
            "description": "Commands relating to the Setup Audit Trail.",
            "subtopics": {
              "display": {
                "description": "Show recent entries in the Setup Audit Trail."
              }
            }
          },
          "inspect": {
            "description": "Commands for inspecting and understanding org configuration.",
            "subtopics": {
              "automations": {
                "description": "Show all automation that fires on a given sObject."
              },
              "dependencies": {
                "description": "Show what a metadata component depends on and what depends on it."
              },
              "field": {
                "description": "Find everywhere a field is referenced across the org's metadata."
              },
              "jobs": {
                "description": "Show async and scheduled jobs running in an org."
              }
            }
          },
          "apex": {
            "description": "Commands relating to Apex.",
            "subtopics": {
              "log": {
                "description": "Tail Apex debug logs in real time."
              },
              "run": {
                "description": "Execute an anonymous Apex file."
              }
            }
          },
          "event": {
            "description": "Commands relating to Platform Events.",
            "subtopics": {
              "subscribe": {
                "description": "Subscribe to Platform Events."
              }
            }
          },
          "deploy": {
            "description": "Commands relating to deployments.",
            "subtopics": {
              "cancel": {
                "description": "Cancel a pending or in-progress Salesforce deploy."
              }
            }
          },
          "profile": {
            "description": "Commands relating to Profiles.",
            "subtopics": {
              "sync": {
                "description": "Sync full Profile metadata from an org into local source."
              }
            }
          },
          "pull": {
            "description": "Commands relating to retrieving metadata.",
            "subtopics": {
              "list": {
                "description": "List metadata types and components available to pull."
              },
              "remote": {
                "description": "Commands relating to retrieving metadata that exists in the org but not locally.",
                "subtopics": {
                  "type": {
                    "description": "Commands relating to remote pull metadata types.",
                    "subtopics": {
                      "add": {
                        "description": "Add metadata types supported by remote pull."
                      },
                      "list": {
                        "description": "List metadata types supported by remote pull."
                      },
                      "remove": {
                        "description": "Remove metadata types supported by remote pull."
                      }
                    }
                  }
                }
              }
            }
          },
          "query": {
            "description": "Commands relating to SOQL queries.",
            "subtopics": {
              "ids": {
                "description": "Run a SOQL query against a large list of Salesforce IDs."
              },
              "record": {
                "description": "Fetch any record by id with full-field output."
              }
            }
          },
          "object": {
            "description": "Commands relating to sObjects",
            "subtopics": {
              "display": {
                "description": "Commands that display information about sObjects",
                "subtopics": {
                  "fields": {
                    "description": "Show field information for a given sObject."
                  },
                  "fieldusage": {
                    "description": "Show how many records populate each field on a given sObject."
                  },
                  "recordtypes": {
                    "description": "Show Record Type information for a given sObject."
                  },
                  "validationrules": {
                    "description": "Show Validation Rule information for a given sObject."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "wireit",
    "clean": "sf-clean",
    "clean-all": "sf-clean all",
    "clean:lib": "shx rm -rf lib && shx rm -rf coverage && shx rm -rf .nyc_output && shx rm -f oclif.manifest.json",
    "compile": "wireit",
    "docs": "sf-docs",
    "format": "wireit",
    "lint": "wireit",
    "postpack": "pinst --enable && shx rm -f oclif.manifest.json",
    "prepack": "pinst --disable && sf-prepack",
    "test": "wireit",
    "test:nuts": "nyc mocha \"**/*.nut.ts\" --slow 4500 --timeout 600000 --parallel",
    "test:only": "wireit",
    "version": "oclif readme"
  },
  "publishConfig": {
    "access": "public"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "messages/**"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "format": {
      "command": "prettier --write \"+(src|test|schemas)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "schemas/**/*.json",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "messages/**",
        "**/.eslint*",
        "**/tsconfig.json"
      ],
      "output": []
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "test:only": {
      "command": "nyc mocha \"test/**/*.test.ts\"",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        ".mocha*",
        "!*.nut.ts",
        ".nycrc"
      ],
      "output": []
    },
    "test:command-reference": {
      "command": "\"./bin/dev\" commandreference:generate --erroronwarnings",
      "files": [
        "src/**/*.ts",
        "messages/**",
        "package.json"
      ],
      "output": [
        "tmp/root"
      ]
    },
    "test:deprecation-policy": {
      "command": "\"./bin/dev\" snapshot:compare",
      "files": [
        "src/**/*.ts"
      ],
      "output": [],
      "dependencies": [
        "compile"
      ]
    },
    "test:json-schema": {
      "command": "\"./bin/dev\" schema:compare",
      "files": [
        "src/**/*.ts",
        "schemas"
      ],
      "output": []
    }
  },
  "author": "@tomcarman"
}
